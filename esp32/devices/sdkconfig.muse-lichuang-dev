# Lichuang (LCKFB) "Szpi" ESP32-S3 development board (board X9200-MB):
# ESP32-S3R8 module with 16 MB flash and 8 MB octal PSRAM, 320x240
# ST7789 SPI touch LCD (FT6336), ES8311 speaker DAC and ES7210 dual-mic
# ADC, PCA9557 expander. USB reaches the board through a CH334F hub:
# the S3's native USB Serial/JTAG (303a:1001) and a CH340 bridge.
# Pins: xiaozhi-esp32's lckfb/szpi-esp32s3 board and the vendor
# schematic SCH_X9200-MB-V1.0A_20250828. Load last, after
# sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_DEVICE_MODEL_ID="muse-gadget-lichuang-dev"
CONFIG_MUSE_DEVICE_MODEL_NAME="Lichuang Szpi ESP32-S3"
CONFIG_MUSE_BOARD_LICHUANG_DEV=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM is required for the UI, images, voice session and tunnel.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Static buffers in PSRAM, as on the ATK-DNESP32S3-BOX2: without it BLE
# setup can't find the internal RAM for its task. The module always
# has PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# The avatar's and audio's static buffers too (about 17 KB): only the
# CPU touches them, and Link and Muse's sessions need the internal RAM.
CONFIG_MUSE_STATIC_BUFFERS_IN_PSRAM=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# Sold to Chinese speakers: captions fall back to a CJK font instead
# of showing boxes. Noto Sans SC (anti-aliased, GB2312 coverage, about
# 910 KB) rather than Unifont's 1-bit bitmaps (about 1.2 MB).
CONFIG_MUSE_CJK_FONT=y
CONFIG_MUSE_CJK_FONT_NOTO=y
# Live voice calls with Muse (experimental): tap to call, Muse
# answers out loud, no TTS key needed. Turn off in menuconfig if the
# account's VM refuses calls; voice notes keep working either way.
CONFIG_MUSE_REALTIME_VOICE=y
# Spoken replies via Volcano TTS (start_tts in muse_chat_session.cpp).
# The API key is filled in locally on the build machine; never commit it.
CONFIG_MUSE_TTS_VOLCANO_API_KEY=""
CONFIG_MUSE_TTS_VOLCANO_RESOURCE_ID="seed-tts-2.0"
CONFIG_MUSE_TTS_VOLCANO_SPEAKER="zh_female_xiaohe_uranus_bigtts"

# Home page: idle tile with clock, date, Shanghai weather + air quality
# (Open-Meteo, no key). Boot and idle land on it; sleep unchanged.
CONFIG_MUSE_HOME_PAGE=y
CONFIG_MUSE_HOME_CITY="上海"
CONFIG_MUSE_HOME_LAT="31.2304"
CONFIG_MUSE_HOME_LON="121.4737"

# Komari server-status page between the home page and the Muse face.
# The panel URL is deliberately left empty in this repo: set it in
# Settings -> Komari (stored in NVS) or fill it in locally.
CONFIG_MUSE_KOMARI_PAGE=y
CONFIG_MUSE_KOMARI_URL=""

# Xiaozhi voice-agent page between Komari and the Muse face; the OTA
# URL defaults to the official Xiaozhi service (Settings -> Xiaozhi
# can point it at a self-hosted server; stored in NVS).
CONFIG_MUSE_XIAOZHI_PAGE=y

# Xiaozhi tasks run with PSRAM stacks: internal RAM on this board is
# nearly exhausted by the stock firmware.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Internal RAM is the scarce resource on this board (TLS setup, task
# creation and lwIP have all failed for want of it) while PSRAM is
# plentiful, so push everything that can live there out: mbedTLS
# allocations (handshake state, record buffers) go to PSRAM and its
# record buffers size dynamically instead of pinning 2x16 KB per
# connection, and malloc() only insists on internal RAM up to 4 KB
# (the shared defaults say 16 KB). The 64 KB internal reserve for
# DMA-only callers is unchanged.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Muse link tasks (VM lookup) get PSRAM stacks via the SDK's own
# helper; internal RAM's largest block is only ~2-4 KB at runtime,
# so the 8 KB internal stack allocation failed ("no memory for
# its task"). Needs FETCH_INSTRUCTIONS + RODATA in PSRAM (set
# above) so flash writes keep the cache on.
CONFIG_HOMEHUB_SETUP_TASKS_IN_PSRAM=y

# Camera: GC2145 capture for photo notes, the camera.capture Home
# Link command and the Xiaozhi MCP camera tool (QVGA RGB565, PSRAM,
# software JPEG).
CONFIG_MUSE_LICHUANG_CAMERA=y
